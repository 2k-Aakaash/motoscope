# Copy to .env.local. Never commit real values.
# PostgreSQL connection (use a pooled endpoint on serverless hosts, e.g. Neon pooler / PgBouncer).
DATABASE_URL=postgres://motoscope:change-me-local-only@localhost:5432/motoscope
# Optional pool tuning.
DATABASE_POOL_MAX=10
# Public canonical site URL used for metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "enabled" only on the production deployment. Anything else serves noindex + a disallow-all robots.txt.
SITE_INDEXING=
# Optional: shown as the Contact link in the footer when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to "true" only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel), for per-client rate limits.
TRUST_PROXY=
# Integration tests: a database the test run may wipe (schema is dropped and recreated).
MOTOSCOPE_TEST_DB=postgres://motoscope:change-me-local-only@localhost:5432/motoscope_test
# Carapis marketplace listings (server-side only; never prefix with NEXT_PUBLIC_). See docs/CARAPIS_INTEGRATION.md.
CARAPIS_API_KEY=
CARAPIS_BASE_URL=https://api.carapis.com/v2
# Per-client limit on routes that call the paid provider.
RATE_LIMIT_PROVIDER_PER_MINUTE=20
