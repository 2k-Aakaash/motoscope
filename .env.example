# MotoScope environment variables — copy to the locations below and fill in real values.
# Never commit real secrets. Every value here is a placeholder or a local-only default.

# ---------------------------------------------------------------------------
# Docker Compose (docker-compose.yml reads these from ./.env)
# ---------------------------------------------------------------------------
POSTGRES_USER=motoscope
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=motoscope
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Application (apps/web/.env.local) — see apps/web/.env.example for the full list.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://motoscope:change-me-local-only@localhost:5432/motoscope
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Integration tests: a disposable database (its schema is dropped and recreated on every run).
MOTOSCOPE_TEST_DB=postgres://motoscope:change-me-local-only@localhost:5432/motoscope_test

# Carapis marketplace listings (server-side only; never prefix with NEXT_PUBLIC_). See docs/CARAPIS_INTEGRATION.md.
CARAPIS_API_KEY=car_5oCMnpeN7UBj8Lt8NPOi73iv1wvs19eSHulyJpQRxHc
CARAPIS_BASE_URL=https://api.carapis.com/v2
